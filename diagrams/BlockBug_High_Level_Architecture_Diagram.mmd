flowchart LR
    %% Active BlockBug architecture

    USERS["Administrators, Managers,<br/>Developers, and Testers"]
    BROWSER["Web Browser"]
    FRONTEND["Vite + React 19<br/>Single-page application"]
    API["Laravel 12<br/>REST API"]
    DB[("Laragon MySQL<br/>blockbug")]
    LEGACY["Commented legacy blockchain code<br/>not executed"]

    USERS --> BROWSER
    BROWSER -->|"HTTP"| FRONTEND
    FRONTEND -->|"JSON API"| API
    API <-->|"Application data"| DB
    LEGACY -.->|"Reference only"| API

